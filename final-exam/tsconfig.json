{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun", "node"],
    "verbatimModuleSyntax": false
  },
  "include": [
    "scripts/**/*.ts",
    "tests/selenium/**/*.ts",
    "tests/appium/**/*.ts",
    "types/**/*.d.ts"
  ]
}
